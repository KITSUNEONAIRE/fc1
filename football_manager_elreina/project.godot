; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited manually.

config_version=5

[application]

config/name="Football Manager: Elreina Edition"
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoloads/GameState.gd"
WorldGenerator="*res://autoloads/WorldGenerator.gd"
TimeSystem="*res://autoloads/TimeSystem.gd"
EventManager="*res://autoloads/EventManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="compatibility"
textures/canvas_textures/default_texture_filter=0
